    Private Sub Form_Load()
        Dim folderPic As StdPicture
        
        On Error GoTo FormLoadFailed
        StartupTrace "Form_Load enter"
        
        StartupTrace "Form_Load create fso"
        Set fso = New FileSystemObject
        On Error Resume Next
        If fso.FileExists(App.Path & "\debug_log.txt") Then fso.DeleteFile(App.Path & "\debug_log.txt")
        If Err.Number <> 0 Then StartupTraceError "Form_Load delete debug_log"
        On Error GoTo FormLoadFailed
        
        StartupTrace "Form_Load LoadImages"
        LoadImages
        StartupTrace "Form_Load folder icons"
        Set folderPic = GetImageStd(resFolderClosed)
        If Not folderPic Is Nothing Then Set FolderList.FolderClosedIcon = folderPic
        Set folderPic = Nothing
        Set folderPic = GetImageStd(resFolderOpen)
        If Not folderPic Is Nothing Then Set FolderList.FolderOpenIcon = folderPic
        Set folderPic = Nothing
        If Err.Number <> 0 Then StartupTraceError "Form_Load folder icons"
        
        ' Skip the resource dump when this is an elevated resume: the old instance
        ' may still have those files open and Open For Append raises error 70.
        StartupTrace "Form_Load EnumerateAllResources"
        If InStr(1, Command$, "/resume", vbTextCompare) = 0 Then
            EnumerateAllResources
        End If
                
        StartupTrace "Form_Load caption"
        Me.Caption = "tBHelper (RC1 12-22-25)"
        
        'WriteToDebugLogFile "Form load"
        
        StartupTrace "Form_Load clsSettings"
        loadingSettingsFromFile = True
        Set tbHelperSettings = New clsSettings
        
        ' configure the custom controls on the main form
        StartupTrace "Form_Load SetupTypeFilterButtons"
        SetupTypeFilterButtons

        StartupTrace "Form_Load SetupSettingsToggleSliders"
        SetupSettingsToggleSliders

        StartupTrace "Form_Load SetChangeLogHeader"
        SetChangeLogHeader
          
        StartupTrace "Form_Load Show"
        Me.Show
        Me.MousePointer = vbHourglass
        
        Set activeTypeFilters = New Scripting.Dictionary
        Set activityLog = actLog
        
        ' check for local html used while debugging
        If fso.FileExists(App.Path & "\GitHubReleasesPage.html") Then
            UpdateActivityLog "** using local html file **"
        End If
        
        UpdateActivityLog "Checking for Settings file"
        
        If tbHelperSettings.SettingsFileLoaded Then
            StartupTrace "Form_Load LoadSettingsIntoForm"
            LoadSettingsIntoForm()
            UpdateActivityLog "loaded", True
        Else
            UpdateActivityLog "Not found", True
            UpdateActivityLog "Find user download location and tB location"
            
            ' if there isn't a settings file, then use the users default download path and attempt to find twinBASIC's path
            StartupTrace "Form_Load GetLocalFolders"
            GetLocalFolders
            
            txtDownloadFolder.Text = tbHelperSettings.DownloadFolder.Path
            txttBFolderLocation.Text = tbHelperSettings.twinBASICFolder.Path
            
            If Not tbHelperSettings.twinBASICFolder.IsValid Then
                MessageBox("No twinBASIC folder found.", "info", "Auto find twinBASIC")
            End If
        End If

        loadingSettingsFromFile = False
       
        StartupTrace "Form_Load SetupCustomButtons"
        SetupCustomButtons
        
        txtDownloadFolder.SetValidView(tbHelperSettings.DownloadFolder.IsValid, "Folder does not exisit")
        txttBFolderLocation.SetValidView(tbHelperSettings.twinBASICFolder.IsValid, "Folder does not exisit")
        
        If tbHelperSettings.twinBASICFolder.IsValid Then
            ' the tb folder is fine, display the version contained in the folder
            lblCurrentTBVersion.Visible = True
            lblCurrentTBVersion.Caption = InstalledVersion & " " & tbHelperSettings.twinBASICFolder.tBVersion
        End If
        
        ' enable or disable view log button
        'WriteToDebugLogFile "  Form load set btnViewLogHistory.Enabled "
        btnViewLogHistory.Enabled = fso.FileExists(App.Path & "\log.txt")
        
        Dim resumeSwitch As String
        Dim resumeZip As String
        Dim isResume As Boolean
        isResume = ParseResumeCommand(resumeSwitch, resumeZip)
        
        ' this continues to check for version info if the folders are valid
        If Not isResume Then
            If tbHelperSettings.CheckForNewVersionOnLoad Then
                StartupTrace "Form_Load CheckForNewVersion"
                CheckForNewVersion
                
                ' checking if there are change logs means there is at least 1 new version available
                If chgLogs.Count > 0 Then
                    ' turn on the available toggles for the filters
                    SetInitialTypeFilters()
                Else
                    ' no change log means no new version
                    SetDownloadButtonToCheckForVersion
                End If
            Else
                ' settings say don't check for a newer version on load
                'WriteToDebugLogFile "  Form load set btnDownload Caption and Icon "
                SetDownloadButtonToCheckForVersion
            End If
        Else
            SetDownloadButtonToCheckForVersion
        End If
        
        EnableDownloadButton()
        
        StartupTrace "Form_Load FlushRedraws"
        FlushRedraws
        
        StartupTrace "Form_Load CalculateDPIValues"
        CalculateDPIValues
        
        Me.MousePointer = vbDefault
        
        If isResume Then
            StartupTrace "Form_Load FinishResumeOperation"
            On Error Resume Next
            FinishResumeOperation resumeSwitch, resumeZip
            If Err.Number <> 0 Then StartupTraceError "Form_Load FinishResumeOperation"
            On Error GoTo FormLoadFailed
        End If
        
        StartupTrace "Form_Load leave"
        Exit Sub
        
FormLoadFailed:
        StartupTraceError "Form_Load"
        Me.MousePointer = vbDefault
    End Sub

    Private Sub Form_Click()
        
        ' if one of the panels with a dropdown is displayed and the form is clicked
        ' hide the dropdown
        If isAPanelDisplayed Then
            HideDateList
            HideZipList
            HideDriveList
        End If
        
    End Sub
    
    Private Sub Form_Unload(Cancel As Integer)

        formIsClosing = True
        
        On Error Resume Next
        If Not tbHelperSettings Is Nothing Then
            If tbHelperSettings.SettingsChanged And tbHelperSettings.SaveSettingsOnExit Then tbHelperSettings.SaveSettings()
            If tbHelperSettings.LogActivity Then WriteToLogFile
        End If
        On Error GoTo 0

        Set tbHelperSettings = Nothing
        Set activeTypeFilters = Nothing
        
        Set fso = Nothing
        
    End Sub
    
    Private Sub btnDownload_Click()
        
        ' any panel displaying on the for, ignore this click
        If isAPanelDisplayed Then Exit Sub
        
        ' is the download button captioned to check for which version is available on GitHub
        Me.MousePointer = vbHourglass
        If btnDownload.Caption = CheckForVersion Then
            UpdateActivityLog "Manual check for new version"
            
            chgLogs.GetNewerReleasedVersions(tbHelperSettings.twinBASICFolder.tBVersion)
        
            ' the result of checking is that no new version is available at this time
            If chgLogs.versionCheckResult = "Latest version already installed" Then
                UpdateActivityLog "none available", True
            Else
                FilltBChangeLog
                SetInitialTypeFilters

                UpdateActivityLog "Version " & chgLogs.LatestVersion & " is available"
                'WriteToDebugLogFile "  btnDownload Click set btnDownload caption and icon "
                btnDownload.Caption = "Download version " & chgLogs.LatestVersion
                btnDownload.ButtonImagePtr = GetImagePtr(resDownload)
                
            End If
        
            Me.MousePointer = vbDefault
            'WriteToDebugLogFile("Form1 - btnDownload: exiting")
            
        Else
    
            ' use the version number to download the latest release
            ' example of the dowmload url: https://github.com/twinbasic/twinbasic/releases/download/beta-x-0641/twinBASIC_IDE_BETA_641.zip
            Dim newReleaseURL As String = githubReleasesURL & "/download/beta-x-" & IIf(chgLogs.LatestVersion < 1000, "0" & CStr(chgLogs.LatestVersion), chgLogs.LatestVersion)
            Dim justTheFileName As String = "twinBASIC_IDE_BETA_" & chgLogs.LatestVersion & ".zip"
            Dim localZipFileName As String = txtDownloadFolder.Text & justTheFileName
            Dim downloadTheZip As Boolean = True
        
            'WriteToDebugLogFile("Form1 - btnDownload: Click as Download function")
            If fso.FileExists(localZipFileName) Then
                Me.MousePointer = vbDefault
                
                'WriteToDebugLogFile "file exisits"
                ' the zip has been downloaded already
                UpdateActivityLog "The zip exists in the download folder, redownload it?"
                'WriteToDebugLogFile "show the message form"
                
                FlushRedraws ' refesh the button to allow it to process anything it needs to do()
                DoEvents
                
                Dim msgResponse As String = MessageBox("The file [font color=rgb(4, 55, 242)]'" & localZipFileName & "'[/font] already exists. Download it again? [i](if no, then the current file will be used)[/i]", _
                                                "Question", "Previously Downloaded", "Yes", "No", "Cancel")
                'WriteToDebugLogFile "returned from message form, response was " & msgResponse
                
                downloadTheZip = False
                Select Case msgResponse
                    Case vbNullChar, "Cancel"   ' closed the message with X button or clicked cancel
                        UpdateActivityLog "The process has been cancelled by the user."
                        'WriteToDebugLogFile "Exit btnDownload Click as the operation was cancelled by the user."
                        Exit Sub
                    Case "No" ' no don't download
                        downloadTheZip = False
                    Case "Yes"  ' yes download the zip again
                        downloadTheZip = True
                End Select
                
                'WriteToDebugLogFile "a button was selected"
                If downloadTheZip Then
                    fso.DeleteFile(localZipFileName)
                    UpdateActivityLog "Deleted the previous zip file " & localZipFileName, False
                End If
                Me.MousePointer = vbHourglass
            End If

            UpdateActivityLog IIf(downloadTheZip, "Yes", "No"), True
            If downloadTheZip Then
                UpdateActivityLog "Downloading twinBasic " & chgLogs.LatestVersion
                URLDownloadToFile 0, newReleaseURL & "/" & justTheFileName, localZipFileName, 0, 0
                UpdateActivityLog "done ", True
            End If
        
            If formIsClosing Then Exit Sub
            If ProcessDownloadedZip(localZipFileName) Then
                If formIsClosing Then Exit Sub
        
                UpdateActivityLog "process complete"

                ' after the latest has been downloaded, set the download button to a manual check
                'WriteToDebugLogFile "Update btnDownlod to say 'Check for new version'"
                SetDownloadButtonToCheckForVersion
                
                ' if the option to auto unzip the file is selected, check to make sure the files in the tB folder are the new version
                ' before changing the version info on the form
                If tbHelperSettings.PostDownloadAction = 3 And GetTBVersionInFolder(txttBFolderLocation.Text) = chgLogs.LatestVersion Then
                    lblCurrentTBVersion.Caption = InstalledVersion & chgLogs.LatestVersion
                    lblCurrentTBVersion.Visible = True
                End If
            End If
            
        End If
        
        If formIsClosing Then Exit Sub
        FlushRedraws
        Me.MousePointer = vbDefault
         
    End Sub
    
    Private Sub btnSelectDownloadFolder_Click()
        
        ' check for a panel already displayed
        If isAPanelDisplayed Then Exit Sub
        
        ConfigureSelectFolderButtons()
                
        ' Populate the drives listbox and set the initial selection
        PopulateDrivesList
        
        ' if there are drives found and there isn't a previous selection that needs to be highlighted
        If lstDrives.ListCount > 0 And Len(txtDownloadFolder.Text) = 0 Then
            lstDrives.ListIndex = 0
            DrivePicker.Item = lstDrives.Text
            
            ' Explicitly populate the folder list with the initial drive.
            ' This ensures it happens after the drive is set and the control is ready.
            FolderList.ShowDrive DrivePicker.Item
            
        ElseIf Len(txtDownloadFolder.Text) > 0 Then
            ' highlight the passed SelectedPath
            Dim previousDrive As String = Left(txtDownloadFolder.Text, 2)
            
            If DoesDriveExist(previousDrive) Then
                DrivePicker.Item = previousDrive ' select the drive in the dropdown
                FolderList.Path = txtDownloadFolder.Text
            Else
                DrivePicker.Item = "C:"
                FolderList.Path = "\"
            End If
            
            FolderList.ShowDrive DrivePicker.Item    ' make sure that drive's folders are listed
        End If
        
        ShowPanelView frmInnerSelectFolder
        lblSelectFolderTitle.Caption = "Select a download folder"
        
        FlushRedraws

        'FolderList.SetFocus()
        'FolderList.Refresh()
    End Sub
    
