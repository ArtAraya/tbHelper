    Private Sub txtDownloadFolder_LostFocus()
        
        ' check for the message box displaying or the form is closing
        If isAPanelDisplayed Or formIsClosing Then Exit Sub
        
        If fso.FolderExists(txtDownloadFolder.Text) Then
            ' complete the path
            If Right(txtDownloadFolder.Text, 1) <> "\" Then txtDownloadFolder.Text += "\"

            tbHelperSettings.DownloadFolder.Path = txtDownloadFolder.Text
            txtDownloadFolder.SetValidView(True)
            
        Else
            ' indicate an invalid selection
            txtDownloadFolder.SetValidView(False, "Folder does not exisit")
        End If
        
        EnableDownloadButton()
        
        FlushRedraws
    End Sub
    
    Private Sub txttBFolderLocation_LostFocus()
        
        ' check for the message box displaying
        If isAPanelDisplayed Or formIsClosing Then Exit Sub
        
        Dim newtBLocationFolder As Boolean = False
        Dim previousPath As String = tbHelperSettings.twinBASICFolder.Path
                
        ' if there is a folder name in the textbox and folder doesn't exist, create it?
        If Not fso.FolderExists(txttBFolderLocation.Text) And Not Trim(txttBFolderLocation.Text) = "" Then
            ' ask the user if the folder should be created (like a first time setup)
            If MessageBox("This folder doesn't exist. Should it be created?", "question", "twinBASIC Location", "Yes", "No") = "Yes" Then
                On Error Resume Next
                fso.CreateFolder(txttBFolderLocation.Text)
                If Not fso.FolderExists(txttBFolderLocation.Text) Then
                    UpdateActivityLog "Unable to create the twinBASIC folder " & txttBFolderLocation.Text & " as requested"
                    MessageBox("Unable to create the folder." & vbCrLf & Err.Description, "error", "Creation Error")
                    txttBFolderLocation.SetValidView(False, "Folder cold not be created")
                    txttBFolderLocation.SetFocus()
                Else
                    tbHelperSettings.twinBASICFolder.Path = txttBFolderLocation.Text
                    tbHelperSettings.twinBASICFolder.ForceValid
                    
                    txttBFolderLocation.SetValidView(True)
                    lblCurrentTBVersion.Caption = InstalledVersion & " N/A"
                    newtBLocationFolder = True
                    UpdateActivityLog "The twinBASIC folder " & txttBFolderLocation.Text & " was created"
                End If
                On Error GoTo 0
            End If
        End If
        
        Me.MousePointer = vbHourglass
        
        ' is the folder to install twinBASIC to valid?
        If Not newtBLocationFolder Then
            ' the user didn't create a new tBFolder
            'WriteToDebugLogFile("Lost focus - checking folder for its tB version")
            If fso.FolderExists(txttBFolderLocation.Text) Then
            
                ' complete the path
                If Right(txttBFolderLocation.Text, 1) <> "\" Then txttBFolderLocation.Text += "\"
                
                Dim prevInstalledVersion As Integer = tbHelperSettings.twinBASICFolder.tBVersion
                
                tbHelperSettings.twinBASICFolder = txttBFolderLocation.Text
                
                'WriteToDebugLogFile("Lost focus - GetTBVersionInFolder returned " & tbHelperSettings.twinBASICFolder.tBVersion)
                If tbHelperSettings.twinBASICFolder.tBVersion = 0 Then
                    ' indicate an invalid selection
                    lblCurrentTBVersion.Caption = ""
                    txttBFolderLocation.SetValidView(False, "Folder does not contain twinBASIC")
                
                    MessageBox("Folder [font color=vbBlue]'" & txttBFolderLocation.Text & "' [/font]; no twinBASIC version found.", "info", "twinBASIC version check")
                Else
                    
                    If Not txttBFolderLocation.IsViewValid Then txttBFolderLocation.SetValidView(True)
                    
                    ' this didn't update the label properly (maybe need a custom control for it)
                    lblCurrentTBVersion.Caption = InstalledVersion & tbHelperSettings.twinBASICFolder.tBVersion
                    'InvalidateRect(Form1.hWnd, 0, 1)
                    'UpdateWindow(Form1.hWnd)
                    
                    'WriteToDebugLogFile("label updated and queued (" & Form1.hWnd & ") form for redraw (" & lblCurrentTBVersion.Caption & ")")
                                        
                    If prevInstalledVersion <> tbHelperSettings.twinBASICFolder.tBVersion Then
                        ' a new location with twinBASIC was selected, if the setting for check for a new version on load then check
                        
                        If FoldersAreValid Then
                            
                            If tbHelperSettings.CheckForNewVersionOnLoad Then
                                CheckForNewVersion
                            Else
                                SetDownloadButtonToCheckForVersion
                            End If
                        End If
                        
                    End If
                    
                    'tbHelperSettings.twinBASICFolder.Path = txttBFolderLocation.Text
                End If
                
                
            Else
                ' indicate an invalid selection
                lblCurrentTBVersion.Caption = ""
                txttBFolderLocation.SetValidView(False, "Folder does not exisit")
            End If
                        
        End If
        
        InvalidateLabelRegion lblCurrentTBVersion
        
        FlushRedraws()
        
        Me.MousePointer = vbDefault
 
        EnableDownloadButton
        FlushRedraws()
        
    End Sub
    
    '**************************************
    '   local procedures
    '**************************************** 
    Private Sub CheckForNewVersion()
        
        ' should tBHelper look for a newer version?
        UpdateActivityLog "Checking for new version"
        chgLogs.GetNewerReleasedVersions(tbHelperSettings.twinBASICFolder.tBVersion, True)
            
        If chgLogs.tBVersionGap > 0 Then
            ' there is at least 1 new version available
            btnDownload.Caption = "Download version " & chgLogs.LatestVersion
            btnDownload.ButtonImagePtr = GetImagePtr(resDownload)
            FilltBChangeLog()
            UpdateActivityLog "Newest version available is " & chgLogs.LatestVersion
        Else
            UpdateActivityLog "No newer version available"
        End If
           
        EnableDownloadButton
        
    End Sub
    
    Private Sub ConfigureToggleSlider(tsToggle As ucToggleSlider)
        
        tsToggle.OnColor = CUST_BTN_BCOLOR
        tsToggle.SlideSpeed = 3
        
    End Sub
    
    Private Sub ConfigureTypeFilterButton(tfButton As ucTypeFilter, buttonCaption As String, buttonBackColor As Long, Optional FilterText As String = "")
        
        If FilterText = "" Then FilterText = buttonCaption
        
        tfButton.BorderRadius = 3
        tfButton.TypeName = buttonCaption
        tfButton.FilterText = FilterText
        tfButton.WidthOverride = 1065
        tfButton.Backcolor = buttonBackColor
        tfButton.FontSize = 9.75
        tfButton.Enabled = False
        
    End Sub
    
    Private Sub EnableDownloadButton()

        ' should the download zip button be enabled?
        'WriteToDebugLogFile "EnableDownloadButton FoldersAreValid " & FoldersAreValid & "; chgLogs.tBVersionGap: " & chgLogs.tBVersionGap & " btnDownload.Caption='" & btnDownload.Caption & "'"
        
        ' the download and the twinBASIC folder are valid 
        ' and (there is a difference between the available version and the installed version or the button is set to manually check for a new version)
        btnDownload.Enabled = FoldersAreValid And (chgLogs.tBVersionGap > 0 Or btnDownload.Caption = CheckForVersion)
        
        If btnDownload.Enabled Then
            ' add the final forward slash if needed
            If Right(txtDownloadFolder.Text, 1) <> "\" Then txtDownloadFolder.Text += "\"
            If Right(txttBFolderLocation.Text, 1) <> "\" Then txttBFolderLocation.Text += "\"
        End If
        
    End Sub
    
    Public Sub FilltBChangeLog()
        
        ' inital write of entries to the changelog 
        Dim clItem As clsChangeLogItem
        
        lblNewVersions.Caption = ""
         'WriteToDebugLogFile("FilltBChangeLog versoin gap:" & chgLogs.tBVersionGap)
        If chgLogs.tBVersionGap > 1 Then
           
            Label9.Caption = "Change logs for "
            lblNewVersions.Caption = CStr(tbHelperSettings.twinBASICFolder.tBVersion + 1) & IIf(chgLogs.tBVersionGap = 2, " and ", " thru ") & chgLogs.LatestVersion
            
        ElseIf chgLogs.tBVersionGap = 1 Then
            Label9.Caption = "Change Log for "
            lblNewVersions.Caption = chgLogs.LatestVersion
        Else
            Label9.Caption = "Change Log"
        End If
        
        clgView.Clear
        
        clgView.BeginUpdate()
        For Each clItem In chgLogs
            clgView.AddEntry(clItem.tBVersion, clItem.Type, clItem.Notes)
        Next
        clgView.EndUpdate()
        
    End Sub
    Private Function FoldersAreValid() As Boolean
    
         Return tbHelperSettings.DownloadFolder.IsValid And tbHelperSettings.twinBASICFolder.IsValid
        
    End Function
    
    Private Sub LoadSettingsIntoForm()
    
        'Set the controls on the form with their settings values
        With Form1
            .txtDownloadFolder.Text = tbHelperSettings.DownloadFolder.Path
            .txttBFolderLocation.Text = tbHelperSettings.twinBASICFolder.Path
            Select Case tbHelperSettings.PostDownloadAction
                Case 1
                    .optOpenFolder.Value = True
                Case 2
                    .optOpenZip.Value = True
                Case 3
                    .optInstallTB.Value = True
            End Select
            .tsLookForUpdateAtLaunch.IsOn = tbHelperSettings.CheckForNewVersionOnLoad
            .tsStartTB.IsOn = tbHelperSettings.StarttwinBASICAfterUpdate
            .tsLogActivity.IsOn = tbHelperSettings.LogActivity
            .tsSaveSettingsOnExit.IsOn = tbHelperSettings.SaveSettingsOnExit
        End With
    
    End Sub

    Private Function InstallTwinBasic(tBZipFile As String, Optional ByVal resumeAction As String = "/resumeInstall") As Boolean
        
        ' Extract to a temp folder first, then replace files in the destination.
        ' Never delete the destination folder itself: under Program Files a
        ' non-admin user can often delete the folder but cannot recreate it.
        Dim destPath As String
        Dim parentPath As String
        Dim tempPath As String
        Dim destExists As Boolean
        Dim unzipped As Boolean
        Dim errMsg As String
    
        On Error GoTo ErrorUnZiping
    
        g_ElevationAbortQuiet = False
        g_ElevationRelaunchStarted = False
        destPath = tbHelperSettings.twinBASICFolder.Path
        parentPath = GettBParentFolder()
        destExists = fso.FolderExists(destPath)
    
        If destExists Then
            Select Case ProbeDestWriteAccess(destPath)
                Case WRITEPROBE_OK
                    ' this process can replace the installed files
                Case WRITEPROBE_SHARING
                    UpdateActivityLog "Cannot replace " & destPath & " (twinBASIC.exe is in use)"
                    MessageBox("twinBASIC.exe is in use in [font color=vbblue]'" & destPath & "'[/font]." & vbCrLf & _
                        "Close twinBASIC and try again. The folder was not changed.", _
                        "warning", "twinBASIC is running")
                    Exit Function
                Case Else
                    If AbortInstallForWriteAccess(destPath, tBZipFile, resumeAction) Then Exit Function
            End Select
        Else
            If Not FolderAllowsCreateSubfolder(parentPath) Then
                If AbortInstallForWriteAccess(destPath, tBZipFile, resumeAction) Then Exit Function
            End If
        End If
    
        tempPath = NormalizeFolderPath(fso.GetSpecialFolder(2).Path) & "tbHelper_extract_" & Format(Now, "yyyymmddhhnnss")
        fso.CreateFolder tempPath
    
        With New cZipArchive
            If Not .OpenArchive(tBZipFile) Then
                fso.DeleteFolder tempPath, True
                MessageBox("Unable to open the zip file [font color=vbblue]'" & tBZipFile & "'[/font].", "error", "Error Unzipping twinBASIC")
                Exit Function
            End If
            unzipped = .Extract(tempPath)
        End With
    
        If Not unzipped Then
            If fso.FolderExists(tempPath) Then fso.DeleteFolder tempPath, True
            MessageBox("Unable to extract [font color=vbblue]'" & tBZipFile & "'[/font] to a temporary folder.", "error", "Error Unzipping twinBASIC")
            Exit Function
        End If
    
        If destExists Then
            If Not ClearFolderContents(destPath) Then
                If OfferElevationAfterReplaceFailed(destPath, tBZipFile, resumeAction, tempPath) Then Exit Function
                MessageBox("Could not replace files in [font color=vbblue]'" & destPath & "'[/font]. The folder itself was not removed." & vbCrLf & _
                    "The extracted files are still in [font color=vbblue]'" & tempPath & "'[/font].", _
                    "error", "Error Unzipping twinBASIC")
                Exit Function
            End If
        Else
            If Not EnsureFolderExists(destPath) Then
                If OfferElevationAfterReplaceFailed(destPath, tBZipFile, resumeAction, tempPath) Then Exit Function
                MessageBox("Could not create [font color=vbblue]'" & destPath & "'[/font].", "error", "Error Unzipping twinBASIC")
                Exit Function
            End If
        End If
    
        If Not CopyFolderContents(tempPath, destPath) Then
            If OfferElevationAfterReplaceFailed(destPath, tBZipFile, resumeAction, tempPath) Then Exit Function
            MessageBox("Extracted files could not be copied to [font color=vbblue]'" & destPath & "'[/font]." & vbCrLf & _
                "The extracted files are still in [font color=vbblue]'" & tempPath & "'[/font].", _
                "error", "Error Unzipping twinBASIC")
            Exit Function
        End If
    
        If fso.FolderExists(tempPath) Then fso.DeleteFolder tempPath, True
    
        InstallTwinBasic = fso.FolderExists(destPath)
        Exit Function
    
        ErrorUnZiping:
        errMsg = Err.Description
        InstallTwinBasic = False
        On Error Resume Next
        If Len(tempPath) > 0 And fso.FolderExists(tempPath) Then fso.DeleteFolder tempPath, True
        On Error GoTo 0
        UpdateActivityLog "Error during InstalltwinBASIC: " & errMsg
        MessageBox("Encountered an error attempting to install twinBASIC" & vbLf & errMsg, "error", "Error Unzipping twinBASIC")
    
    End Function
    
    Private Function OfferElevationAfterReplaceFailed(ByVal destPath As String, ByVal zipFile As String, ByVal resumeAction As String, ByVal tempPath As String) As Boolean
        ' If not elevated, drop the temp extract and ask to restart as administrator.
        On Error GoTo offerFailed
        If IsElevated() Then Exit Function
        On Error Resume Next
        If Len(tempPath) > 0 And Not fso Is Nothing Then
            If fso.FolderExists(tempPath) Then fso.DeleteFolder tempPath, True
        End If
        On Error GoTo offerFailed
        OfferElevationAfterReplaceFailed = AbortInstallForWriteAccess(destPath, zipFile, resumeAction, True)
        Exit Function
offerFailed:
        OfferElevationAfterReplaceFailed = True
        g_ElevationAbortQuiet = True
    End Function
    
    Private Function AbortInstallForWriteAccess(ByVal destPath As String, ByVal zipFile As String, ByVal resumeAction As String, Optional ByVal destMayBePartial As Boolean = False) As Boolean
        ' Returns True so InstallTwinBasic should exit without changing the dest folder.
        Dim folderNote As String
        On Error GoTo abortFailed
        AbortInstallForWriteAccess = True
        
        If destMayBePartial Then
            folderNote = "Some files in that folder may already have been removed. The install is not complete."
        Else
            folderNote = "The existing twinBASIC folder will not be changed until that succeeds."
        End If
        
        If IsElevated() Then
            UpdateActivityLog "Cannot write to " & destPath & " (already running as administrator)"
            MessageBox("tBHelper cannot write to [font color=vbblue]'" & destPath & "'[/font] even as administrator." & vbCrLf & _
                folderNote, "error", "Administrator required")
            Exit Function
        End If
        
        If IsCodeRunningInTheIDE() Then
            UpdateActivityLog "Cannot write to " & destPath & " (administrator rights required; cannot elevate from the IDE)"
            MessageBox("tBHelper cannot write to [font color=vbblue]'" & destPath & "'[/font]." & vbCrLf & _
                folderNote & vbCrLf & vbCrLf & _
                "Run the compiled tBHelper [b]as administrator[/b] to install into this folder. Elevation cannot be started from the IDE.", _
                "error", "Administrator required")
            g_ElevationAbortQuiet = True
            Exit Function
        End If
        
        If MessageBox("tBHelper cannot write to [font color=vbblue]'" & destPath & "'[/font]." & vbCrLf & _
            "Restart as administrator and continue the install? " & folderNote, _
            "question", "Administrator required", "Yes", "No") = "No" Then
            UpdateActivityLog "User declined restarting as administrator"
            g_ElevationAbortQuiet = True
            Exit Function
        End If
        
        If RelaunchElevatedAndResume(Me.hWnd, resumeAction, zipFile) Then
            UpdateActivityLog "Restarting as administrator"
            g_ElevationAbortQuiet = True
            g_ElevationRelaunchStarted = True
            ExitAfterElevatedRelaunch
            Exit Function
        End If
        
        UpdateActivityLog "Administrator prompt was cancelled"
        g_ElevationAbortQuiet = True
        Exit Function
abortFailed:
        AbortInstallForWriteAccess = True
        g_ElevationAbortQuiet = True
    End Function
    
    Private Sub FinishResumeOperation(ByVal resumeSwitch As String, ByVal zipPath As String)
        Dim dest As String
        Dim errMsg As String
        
        On Error GoTo resumeFailed
        If fso Is Nothing Then Exit Sub
        If Not fso.FileExists(zipPath) Then
            MessageBox("The zip file [font color=vbblue]'" & zipPath & "'[/font] was not found. The install could not continue.", "error", "Administrator required")
            Exit Sub
        End If
        
        If UserCancelledBecauseIdeRunning() Then
            UpdateActivityLog "IDE is open - user cancelled"
            Exit Sub
        End If
        
        Me.MousePointer = vbHourglass
        
        If Not InstallTwinBasic(zipPath, resumeSwitch) Then
            If g_ElevationRelaunchStarted Then
                ExitAfterElevatedRelaunch
                Exit Sub
            End If
            Me.MousePointer = vbDefault
            Exit Sub
        End If
        
        dest = tbHelperSettings.twinBASICFolder.Path
        tbHelperSettings.twinBASICFolder.IstwinBASIC = True
        tbHelperSettings.twinBASICFolder.Path = dest
        
        If tbHelperSettings.twinBASICFolder.IsValid Then
            lblCurrentTBVersion.Visible = True
            lblCurrentTBVersion.Caption = InstalledVersion & " " & tbHelperSettings.twinBASICFolder.tBVersion
        End If
        
        Me.MousePointer = vbDefault
        
        UpdateActivityLog "twinBASIC from " & zipPath & " has been extracted and is ready to use."
        
        If resumeSwitch = "/resumeRevert" Then
            MessageBox("The revert process has finished successfully.", "info", "Revert Result")
        Else
            MessageBox("twinBASIC from [font color=vbblue]'" & zipPath & "'[/font] has been extracted and is ready to use.", "info", "Completed")
            If tsStartTB.IsOn Then
                UpdateActivityLog "Start twinBASIC after update is checked, starting it"
                ShellExecute(0, "open", txttBFolderLocation.Text & "\twinBASIC.exe", vbNullString, vbNullString, 1)
                UpdateActivityLog "done", True
            End If
        End If
        Exit Sub
resumeFailed:
        errMsg = Err.Description
        On Error Resume Next
        Me.MousePointer = vbDefault
        MessageBox("Encountered an error finishing the install." & vbCrLf & errMsg, "error", "Administrator required")
    End Sub
    
    Private Function UserCancelledBecauseIdeRunning() As Boolean
        On Error GoTo ideCheckFailed
        If IsCodeRunningInTheIDE Then Exit Function
        If Not IsProcessRunning("twinbasic.exe") Then Exit Function
        
        UpdateActivityLog "Not allowed while the IDE is open"
        Do While IsProcessRunning("twinbasic.exe")
            If MessageBox("The twinBASIC IDE is running. Close it, then click OK to continue, or Cancel to abort.", _
                "warning", "twinBASIC is running", "OK", "Cancel") = "Cancel" Then
                UserCancelledBecauseIdeRunning = True
                Exit Function
            End If
        Loop
        Exit Function
ideCheckFailed:
        UserCancelledBecauseIdeRunning = False
    End Function
    
    '******************************************************
    '**** Message Box
    '******************************************************
    Private Function MessageBox(ByVal msgText As String, _
        Optional ByVal msgType As String = "info", _
        Optional ByVal msgTitle As String = vbNullString, _
        Optional ByVal btn1Caption As String = "OK", _
        Optional ByVal btn2Caption As String = vbNullString, _
        Optional ByVal btn3Caption As String = vbNullString) As String
        Dim msgPic As StdPicture
            
        buttonCaption = ""
        
        ' Load icon based on type
        ' Select Case LCase$(msgType)
        '     Case "info": picIcon.Picture = LoadResPicture("PNG\info.png", vbResBitmap)
        '     Case "warning": picIcon.Picture = LoadResPicture("PNG\warning.png", vbResBitmap)
        '     Case "error": picIcon.Picture = LoadResPicture("PNG\error.png", vbResBitmap)
        '     Case "success": picIcon.Picture = LoadResPicture("PNG\success.png", vbResBitmap)
        '     Case "question": picIcon.Picture = LoadResPicture("PNG\question.png", vbResBitmap)
        ' End Select
        On Error Resume Next
        Select Case LCase$(msgType)
            Case "info": Set msgPic = GetImageStd(resInfo)
            Case "warning": Set msgPic = GetImageStd(resWarning)
            Case "error": Set msgPic = GetImageStd(resError)
            Case "success": Set msgPic = GetImageStd(resSuccess)
            Case "question": Set msgPic = GetImageStd(resQuestion)
        End Select
        If Not msgPic Is Nothing Then picIcon.Picture = msgPic
        Set msgPic = Nothing
        Err.Clear
        On Error GoTo 0
        
        'WriteToDebugLogFile("MessageBox called msgTitle: " & msgTitle)
        
        ' setup the buttons to answer the message box   
        ConfigureCustomButton btnNum1, btn1Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, True, True
        ConfigureCustomButton btnNum2, btn2Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, btn2Caption <> vbNullString, True
        ConfigureCustomButton btnNum3, btn3Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, btn3Caption <> vbNullString, True
        
        btnNum2.Visible = btn2Caption <> vbNullString
        btnNum3.Visible = btn3Caption <> vbNullString
        lblMessageTitle.Caption = msgTitle
        RestoreMessageBoxLayout
        RTFMsg.Message = msgText
        FitMessageBoxToContent
        
        ShowPanelView frmInnerMsgBox

        pnlMessageBox.MousePointer = vbDefault
        
        ' wait until the user clicks a button
        Do While pnlMessageBox.Visible
            DoEvents()
        Loop
        
        MessageBox = buttonCaption
        buttonCaption = vbNullChar
        
    End Function
    
    Private Sub SaveMessageBoxLayout()
        If m_msgLayoutSaved Then Exit Sub
        m_msgInnerW = frmInnerMsgBox.Width
        m_msgInnerH = frmInnerMsgBox.Height
        m_msgRtfW = RTFMsg.Width
        m_msgRtfH = RTFMsg.Height
        m_msgTitleW = lblMessageTitle.Width
        m_msgBtn1Left = btnNum1.Left
        m_msgBtn2Left = btnNum2.Left
        m_msgBtn3Left = btnNum3.Left
        m_msgBtnTop = btnNum1.Top
        m_msgLayoutSaved = True
    End Sub
    
    Private Sub RestoreMessageBoxLayout()
        SaveMessageBoxLayout
        frmInnerMsgBox.Width = m_msgInnerW
        frmInnerMsgBox.Height = m_msgInnerH
        RTFMsg.Width = m_msgRtfW
        RTFMsg.Height = m_msgRtfH
        lblMessageTitle.Width = m_msgTitleW
        btnNum1.Left = m_msgBtn1Left
        btnNum2.Left = m_msgBtn2Left
        btnNum3.Left = m_msgBtn3Left
        btnNum1.Top = m_msgBtnTop
        btnNum2.Top = m_msgBtnTop
        btnNum3.Top = m_msgBtnTop
    End Sub
    
    Private Sub FitMessageBoxToContent()
        ' Grow the inner dialog so GDI-measured text fits at the current DPI.
        ' twinBASIC already DPI-scales control HWNDs; this only adds room when
        ' the wrapped message is larger than the design-time box.
        Const SLACK_PX As Long = 8
        Dim clientW As Long
        Dim clientH As Long
        Dim dW As Long
        Dim dH As Long
        Dim maxInnerW As Long
        Dim maxInnerH As Long
        
        GetClientSizePx RTFMsg.hWnd, clientW, clientH
        maxInnerW = CLng(Me.ScaleWidth * 0.92)
        maxInnerH = CLng(Me.ScaleHeight * 0.85)
        
        If RTFMsg.RequiredWidth > clientW + SLACK_PX Then
            dW = PixelsToTwipsX(RTFMsg.RequiredWidth - clientW + SLACK_PX)
            If frmInnerMsgBox.Width + dW > maxInnerW Then
                dW = maxInnerW - frmInnerMsgBox.Width
            End If
            If dW > 0 Then
                RTFMsg.Width = RTFMsg.Width + dW
                frmInnerMsgBox.Width = frmInnerMsgBox.Width + dW
                lblMessageTitle.Width = lblMessageTitle.Width + dW
                btnNum1.Left = btnNum1.Left + dW
                btnNum2.Left = btnNum2.Left + dW
                btnNum3.Left = btnNum3.Left + dW
                RTFMsg.Message = RTFMsg.Message
                GetClientSizePx RTFMsg.hWnd, clientW, clientH
            End If
        End If
        
        If RTFMsg.RequiredHeight > clientH Then
            dH = PixelsToTwips(RTFMsg.RequiredHeight - clientH + SLACK_PX)
            If frmInnerMsgBox.Height + dH > maxInnerH Then
                dH = maxInnerH - frmInnerMsgBox.Height
            End If
            If dH > 0 Then
                RTFMsg.Height = RTFMsg.Height + dH
                frmInnerMsgBox.Height = frmInnerMsgBox.Height + dH
                btnNum1.Top = btnNum1.Top + dH
                btnNum2.Top = btnNum2.Top + dH
                btnNum3.Top = btnNum3.Top + dH
            End If
        End If
    End Sub
    
