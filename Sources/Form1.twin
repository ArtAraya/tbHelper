    Private Sub buttonClick(responseText As String)
        
        ' set the response button that was clicked and hide the form from view
        'WriteToDebugLogFile("MessageBox, buttonClick, buttonNumber:" & responseText)
        buttonCaption = responseText
        isAPanelDisplayed = False
        pnlMessageBox.Visible = False
