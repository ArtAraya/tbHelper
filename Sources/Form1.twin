    Private Sub btnOkay_Click()
        
        ' assign the selection to the proper textbox

        If Len(FolderList.Path) > 0 Then
            ' there was a selection
            Dim txtBox As Control
            
            If InStr(lblSelectFolderTitle.Caption, "download") > 0 Then
                Set txtBox = txtDownloadFolder
                Dim newFolder As clsSettingsFolder
                newFolder.Path = FolderList.Path
                tbHelperSettings.DownloadFolder = newFolder

            Else
                If Val(GetTBVersionInFolder(FolderList.Path & "\")) = 0 Then
                    ' twinBASIC is not in the selected location
                    MessageBox("The folder chosen, [font color=vbBlue]'" & FolderList.Path & "' [/font][b]does not contain twinBASIC[/b].", "error", "Invalid twinBASIC folder selection")
                    Exit Sub
                End If
                
                Set txtBox = txttBFolderLocation
                tbHelperSettings.twinBASICFolder.Path = FolderList.Path & "\"
                btnDownload.Enabled = True ' user can now check for a new version once a valid folder is selected
                
            End If
            
            txtBox.Text = FolderList.Path
            If Right(txtBox.Text, 1) <> "\" Then txtBox.Text = txtBox.Text & "\"
            
        End If
        
        Set txtBox = Nothing
        
        HidePanelView pnlSelectFolder
    End Sub

