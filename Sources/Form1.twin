        MessageBox("A folder wasn't chosen, [b]the operation was cancelled[/b].", , "No selection")
        
    End Sub
    
    Private Sub frmInnerSelectFolder_Click()
        
        HideDriveList
    End Sub
    
    Private Sub tmrCatchUp_Timer()
        ' check for remaining UI updates that may have happened to quickly
        tmrCatchUp.Enabled = False
        'WriteToDebugLogFile("tmrCatchUp: RedrawCount=" & RedrawQueue.Count)
        If RedrawQueue.Count > 0 Then FlushRedraws()

        If frmInnerSelectFolder.Visible Then
            Debug.Print "refresh attempt from tmrCatchup"
            FolderList.Update()
            FolderList.SetFocus()
            frmInnerSelectFolder.Refresh()
        End If
    End Sub
    
    Private Sub CalculateDPIValues()
        
        Dim hdc As Long
        Dim dpiX As Long
        Dim dpiY As Long

        ' Get the device context (DC) for the screen
        hdc = GetDC(0)

        ' Get the horizontal and vertical DPI values
        dpiX = GetDeviceCaps(hdc, LOGPIXELSX)
        dpiY = GetDeviceCaps(hdc, LOGPIXELSY)

        ' Release the device context
        ReleaseDC 0, hdc

        ' Example for scaling controls (assuming 96 DPI as baseline)
        drop_DPIFontSize = TEXT_BASE_FONT_SIZE * (dpiX / BASE_DPI)
        If drop_DPIFontSize > MAX_FONT_SIZE Then drop_DPIFontSize = MAX_FONT_SIZE

    End Sub

End Class