    Private Function DoesDriveExist(driveLetter As String) As Boolean
        
        Dim searchResult As Boolean = False
        Dim indexNo As Integer = 0
        
        Do Until (searchResult Or indexNo = lstDrives.ListCount)
            lstDrives.ListIndex = indexNo
            searchResult = (UCase(driveLetter) = UCase(lstDrives.Text))
            indexNo = indexNo + 1
        Loop
        
        DoesDriveExist = searchResult
        
    End Function
    
    Private Sub PopulateDrivesList()
        
        'TODO: add volume label to the drive list
        Dim drives As Long
        Dim i As Long
        Dim driveLetter As String
        Dim driveType As Long
        Dim volumeLabel As String
        
        drives = GetLogicalDrives()
        lstDrives.Clear

        For i = 0 To 25
            If (drives And (2 ^ i)) <> 0 Then
                driveLetter = Chr$(65 + i) & ":"
                driveType = GetDriveType(driveLetter & "\")
                If driveType = DRIVE_FIXED Or driveType = DRIVE_REMOVABLE Then
                    'volumeLabel = Dir(driveLetter & ":\", vbVolume)
                    lstDrives.AddItem driveLetter
                End If
            End If
        Next i
    End Sub

    Private Sub DrivePicker_DropDown()
        
        ' toggle the dropdown if it is visible
        If lstDrives.Visible Then
            HideDriveList()
