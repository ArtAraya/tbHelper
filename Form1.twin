        clgColumns(1).WrappedEnabled = False
        
        clgColumns(2).Name = "DESCRIPTION"
        clgColumns(2).Width = 700
        clgColumns(2).WrappedEnabled = True

        clgView.SetColumns = clgColumns

    End Sub
    
