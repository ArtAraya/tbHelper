    Private Sub btnViewLogHistory_Click()

        ' check for the message box displaying
        If isAPanelDisplayed Then Exit Sub
        'isAPanelDisplayed = True
        
        Form1.MousePointer = vbHourglass
        UpdateActivityLog "Loading log file view"
        FlushRedraws
        DoEvents()
                
        ConfigureCustomButton btnDeleteLog, "Delete Log", &HA2640C, vbWhite, App.Path & "\delete.png", 20, False, False
        
        SetupActivityLog
        HideDateList()
        
        fillingLogDuringInitialView = True
        btnDeleteLog.Enabled = FillLogHistoryGrid
        fillingLogDuringInitialView = False
        
        UpdateActivityLog "Ready"
       
        ShowPanelView frmInnerViewLog, 10

        Form1.MousePointer = vbDefault
        
        FlushRedraws
        
    End Sub
    
    Dim logContents As New colHistoryLogItems
    Dim fillingLogDuringInitialView As Boolean
    
    Private Sub btnDeleteLog_Click()
        
        ' user wishes to delete the current log.txt file
        If MessageBox("Are you [b]sure[/b] you want to delete the log file?", "question", "Confirmation", "Yes", "No") = "No" Then Exit Sub

        fso.DeleteFile(App.Path & "\log.txt")
        UpdateActivityLog "Log.txt has been deleted."
        
        If tbHelperSettings.LogActivity Then
            tbHelperSettings.LogActivity = MessageBox("The setting to [b]write to a log file[/b] is still active. Should this be turned off?", "question", "log File Setting", "Yes", "No") = 2
            Form1.tsLogActivity = tbHelperSettings.LogActivity
        End If
        
        clgView.ClearEntries()
        
        DatePicker.Clear()
        lbDropdown.Clear()
        btnDeleteLog.Enabled = False
        
    End Sub

    Private Function FillLogHistoryGrid(Optional ViewDate As String = "") As Boolean
    
        ' open the log text file and display it in the flexgrid
        
        Dim logItem As clsHistoryLogItem
        Dim itemColor As Long
        Dim colNum As Integer
    
        Me.MousePointer = vbHourglass
        If Not logContents.LoadLog Then
            MessageBox("There was an issue reading the log file, can not continue", "error", "View log Failed")
            FillLogHistoryGrid = False
            Exit Function
        End If
    
        clgHistoryView.ClearEntries()
        clgHistoryView.BeginUpdate() ' hold drawing to the canvas until all the entries required have been set
        For Each logItem In logContents
            With clgHistoryView
                If Len(ViewDate) = 0 Or logItem.LogDate = ViewDate Or ViewDate = "Show All" Then
            
                    If logItem.LogCLI.tBVersion = 0 Then
                        .AddEntry(logItem.LogDateTime, "", "", logItem.LogMessage)
                    Else
                        .AddEntry(logItem.LogDateTime, logItem.LogCLI.tBVersion, logItem.LogCLI.Type, logItem.LogCLI.Notes)
                    End If
                
                End If
            
            End With
        
        Next
        clgHistoryView.EndUpdate()  ' draw the canvas not that all the entries required have been set
        
        If Len(ViewDate) = 0 Then
            ' fill the dropdown with the unique dates from the log file
            ' just during the first time through this
            Dim logDate As String
        
            With lbDropdown
                .Clear()
                .AddItem("Show All")()
                For Each logDate In logContents.HistoryLogDates
                    .AddItem(logDate)
                Next
                .ListIndex = 0
            End With
        End If
    
        Me.MousePointer = vbDefault
        FlushRedraws
        FillLogHistoryGrid = True
        
    End Function
    
    Private Sub SetupActivityLog()
        
        Dim clgColumns(3) As New clsChangeLogColumn
        clgColumns(0).Name = "Date Time"
        clgColumns(0).Width = 150
        clgColumns(0).WrappedEnabled = False
        
        clgColumns(1).Name = "Version"
        clgColumns(1).Width = 70
        clgColumns(1).WrappedEnabled = False

        clgColumns(2).Name = "Type"
        clgColumns(2).Width = 140
        clgColumns(2).WrappedEnabled = False
        
        clgColumns(3).Name = "Description"
        clgColumns(3).Width = 375
        clgColumns(3).WrappedEnabled = True
        
        clgHistoryView.SetColumns = clgColumns
        
    End Sub
    
    Private Sub ConfigureDropdownListbox(lbDropdown As ListBox, picker As Control)
        
        Const BORDER_SIZE As Long = 15 ' 1 pixel in Twips
        Const LIST_HEIGHT As Long = 1200
        
        With lbDropdown
            .Width = picker.Width - (BORDER_SIZE * 2)
            .Height = LIST_HEIGHT
            .Left = picker.left
            .Top = picker.top + picker.height
            .FontSize = drop_DPIFontSize
            .Font.Name = "Segoe UI"
            .Visible = True
        End With

        With picDropDownBorder
            .Move lbDropdown.Left - BORDER_SIZE, _
                    lbDropdown.Top - BORDER_SIZE, _
                    lbDropdown.Width + (BORDER_SIZE * 2), _ 
                    lbDropdown.Height + (BORDER_SIZE * 2)
            .Visible = True
        End With

        ApplyBottomRoundedCorners picDropDownBorder, 4, 4 ' Apply to the border first
        ApplyBottomRoundedCorners lbDropdown, 4, 4, True         ' Then apply to the listbox
            
        BringWindowToTop picDropDownBorder.hWnd ' Bring border to the top
        BringWindowToTop lbDropdown.hWnd
        
    End Sub
    
    Private Sub DatePicker_DropDown()

        ' toggle the dropdown if it is visible
        If lbDropdown.Visible Then
            HideDateList()
            Exit Sub
        End If

        ' Find the currently selected version in the list and highlight it
        Dim i As Long
        For i = 0 To lbDropdown.ListCount - 1
            If lbDropdown.List(i) = DatePicker.Item Then
                lbDropdown.ListIndex = i
                Exit For
            End If
        Next i

        ConfigureDropdownListbox lbDropdown, DatePicker
        
    End Sub
    
    Private Sub HideDateList()
    
        DatePicker.Collapse()
        lbDropdown.Visible = False
        picDropDownBorder.Visible = False
    
    End Sub
    
    Private Sub lbDropdown_Click()
        
        If fillingLogDuringInitialView Then
            ' when loading the form there is no need to run this click
            DatePicker.Item = "Show All"
        
        ElseIf lbDropdown.ListIndex > -1 Then
            
            DatePicker.Item = lbDropdown.Text ' Update the picker display
            
            ' Hide the list
            HideDateList
            
            'WriteToDebugLogFile "    lbDropdown_Click, selected date: " & lbDropdown.Text & " HideDateList called"
                        
            FillLogHistoryGrid lbDropdown.Text
            
        End If
        FlushRedraws()
        
    End Sub
    
    Private Sub frmInnerViewLog_Click()
        DatePicker.Collapse()
        HideDateList
    End Sub
    
    '***********************************
    '****  View Revert twinBASIC
    '********************************
    Dim localVersions As String = ";"
    Dim revertToCLs As New colChangeLogItems
    Dim revertToVersion As Integer
    Dim revertToVersionRequiresDownload As Boolean
    Dim ignoreClickEvent As Boolean
    Private Const maxVersions = 9
    
    Private Sub btnShowRevertView_Click()
        
        ' check for the message box displaying or 
        If isAPanelDisplayed Then Exit Sub
        
        revertToVersionRequiresDownload = False
        revertGetGitHubVersionsClicked = False
        rvtVersionChangeLog.ClearEntries()
        
        Form1.MousePointer = vbHourglass
        UpdateActivityLog "Loading revert twinBASIC view"
                
        ignoreClickEvent = True
        FillAvailableZips
        ignoreClickEvent = False
        
        SetupRevertViewButtons
        SetRevertChangeLogHeader
        HideZipList
        
        lblCurrentVersion.Caption = tbHelperSettings.twinBASICFolder.Path & "                containing: " & tbHelperSettings.twinBASICFolder.tBVersion
        lblCurrentDownloadFolder.Caption = tbHelperSettings.DownloadFolder.Path
        UpdateActivityLog "Ready"
        
        ShowPanelView frmInnerRevertView
        
        Form1.MousePointer = vbDefault
        
        FlushRedraws
    End Sub

    Private Sub SetupRevertViewButtons()
                
        ConfigureCustomButton btnReverttB, "Revert tB", CUST_BTN_BCOLOR, vbWhite, App.Path & "\revert.png", 20, False, False
        ConfigureCustomButton btnGetVersionsFromGitHub, "Get Versions From GitHub", CUST_BTN_BCOLOR, vbWhite, App.Path & "\download.png", 20, True, False
        
    End Sub
    
    Private Sub FillAvailableZips()

        ' find any available local zip files to revert to
        Dim tBZipFiles As String
        Dim zipFileVersion As String
        Dim zipFileName As String
        
        tBZipFiles = Dir(tbHelperSettings.DownloadFolder.Path & "twinBASIC_IDE_BETA_*.*")

        If Len(tBZipFiles) > 0 Then
            ZipPicker.Item = "Select version to revert to"
        Else
            ' TODO: ask the user if they want this to go to GitHub and get the versions from Pg1 of the releases
            '       without them having to click the "Get from GitHub" button
            ZipPicker.Item = "No local previous versions found"
            Exit Sub
        End If

        Do While Len(tBZipFiles) > 0
            ' don't include the installed version zip file
            If InStr(tBZipFiles, "_" & tbHelperSettings.twinBASICFolder.tBVersion & ".zip") = 0 Then
            
                ' get just the filename from the full path
                zipFileName = fso.GetFileName(tBZipFiles)
                
                ' find the version number in the file name
                zipFileVersion = Mid(zipFileName, InStr(zipFileName, "BETA_") + 5, 4)
                zipFileVersion = GetZipFileVersionNumber(zipFileVersion)
                
                ' keeping the list of revertable versions to with in 9 from the previous version 
                ' of the current installed version
                If tbHelperSettings.twinBASICFolder.tBVersion - maxVersions <= CInt(zipFileVersion) Then
                    ' save a list of the versions of available in the local zip files
                    localVersions = localVersions & zipFileVersion & ";"

                    lstZipFiles.AddItem(zipFileName)
                End If
                
            End If
            tBZipFiles = Dir()
        Loop
        
        ' if there are 9 locally to choose from, no need to grab any from GitHub
        If lstZipFiles.ListCount = 9 Then
            btnGetVersionsFromGitHub.Enabled = False
            btnGetVersionsFromGitHub.ToolTipText = "The max number of versions to revert too are local"
        End If
        
    End Sub
    
    Private Sub ZipPicker_DropDown()

        ' toggle the dropdown if it is visible
        If lstZipFiles.Visible Then
            HideZipList()
            Exit Sub
        End If

        ' Find the currently selected version in the list and highlight it
        Dim i As Long
        For i = 0 To lstZipFiles.ListCount - 1
            If lstZipFiles.List(i) = ZipPicker.Item Then
                lstZipFiles.ListIndex = i
                Exit For
            End If
        Next i

        ConfigureDropdownListbox lstZipFiles, ZipPicker

    End Sub
    
    Private Sub HideZipList()
    
        ZipPicker.Collapse()
        
        lstZipFiles.Visible = False
        picDropDownBorder.Visible = False
        
    End Sub
    
    Private Sub lstZipFiles_Click()
        
        ' don't run this click event if the button is filling in the listbox
        If revertGetGitHubVersionsClicked Then Exit Sub
        
        If lstZipFiles.ListIndex > -1 Then
            Me.MousePointer = vbHourglass
            ZipPicker.Item = lstZipFiles.Text ' Update the picker display
            
            ' Hide the list
            HideZipList
            
            ' Show Change Log for the select twinBASIC version
            Dim selectedVersion As String
            selectedVersion = Mid(lstZipFiles.List(lstZipFiles.ListIndex), InStr(lstZipFiles.List(lstZipFiles.ListIndex), "BETA_") + 5, 4)
            selectedVersion = GetZipFileVersionNumber(selectedVersion)
                        
            ' is this version available locally?
            ' compare the version selected against the list stored in a string when the dropdown was first filled
            revertToVersionRequiresDownload = Not InStr(localVersions, ";" & selectedVersion & ";") > -1
        
            revertToVersion = CInt(selectedVersion)
        
            lblChangeLogTitle.Caption = "ChangeLog for version " & selectedVersion
            FillChangeLogView()
        
            btnReverttB.Enabled = True
            Me.MousePointer = vbDefault
            
            FlushRedraws
        End If
    End Sub
    
    Private Sub FillChangeLogView()

        Dim revertToCL As clsChangeLogItem
        Dim itemColor As Long
        Dim colNum As Integer
        
        rvtVersionChangeLog.ClearEntries()
        If revertToCLs.Count > 0 Then
            ' the user clicked the get from github button or selected a zip to view once
            FillEntries()
        Else
            Dim localLogs As New colHistoryLogItems
            
            ' check for the local log file having the change log of the selected version to revert to
            If Not localLogs.SearchLog() Then
                ' there are no logs to use
                If revertToCLs Is Nothing Then GetChangeLogsFromGitHub()
                    
                FillEntries()
            Else
                ' there is a log file, search for the selected version change log
                Dim Li As Integer
                
                ' add the logs to the object the fill grid uses
                For Li = 1 To localLogs.Count
                    Set revertToCL = localLogs.Item(Li).LogCLI
                    If revertToCL.tBVersion = revertToVersion Then
                        revertToCLs.Add(revertToCL.tBVersion, revertToCL.Type, revertToCL.Notes)
                    End If
                    Set revertToCL = Nothing
                Next
                
                If revertToCLs.Count = 0 Then
                    ' the change log is not in the history log, fetch it from the releases page
                    GetChangeLogsFromGitHub()
                End If
                
                FillEntries()

            End If
            
            Set localLogs = Nothing
            
        End If
                
        Set revertToCL = Nothing
        
    End Sub

    Private Sub GetChangeLogsFromGitHub()
        
        If revertGetGitHubVersionsClicked Then UpdateActivityLog "Collecting versions from Github"
            revertToCLs.GetNewerReleasedVersions(tbHelperSettings.twinBASICFolder.tBVersion - maxVersions)
        If revertGetGitHubVersionsClicked Then UpdateActivityLog "done", True
        
    End Sub

    Private Sub FillGitHubZips()
        
        ' display a like of the last 9 versions the user can to revert to
        Dim revertToCL As clsChangeLogItem
        Dim lastVersionAdded As Integer = 0
       
        ' load the change logs of the previous 10 twinBASIC versions, uses 10 because the newest will be ignored 
        ' if it is the same as the one installed, if not then it'll be an available version to update to
        ' just incase one is made available inbetween last check and now
        GetChangeLogsFromGitHub()
        
        ZipPicker.Item = "Select version to revert to"
        
        lstZipFiles.Clear()
        For Each revertToCL In revertToCLs
            
            If revertToCL.tBVersion <> tbHelperSettings.twinBASICFolder.tBVersion Then
                ' only need to write the versions to the dropdown once
                If revertToCL.tBVersion <> lastVersionAdded Then
                
                    ' indicate location of each version written 
                    Dim versionNote As String
                    
                    If revertToCL.tBVersion > tbHelperSettings.twinBASICFolder.tBVersion Then
                        versionNote = "[*NEW*]" ' found a new tB version
                    ElseIf InStr(localVersions, ";" & revertToCL.tBVersion & ";") > 1 Then
                        versionNote = "[local]" ' this is available locally
                    Else
                        versionNote = ""
                    End If
                    
                    lstZipFiles.AddItem("twinBASIC_IDE_BETA_" & revertToCL.tBVersion & ".zip" & " " & versionNote)
                    lastVersionAdded = revertToCL.tBVersion
                End If
            End If
        Next
        
        ' check to make sure the last version is added, 
        ' if this if statement fails then page 1 of the releases page doesn't have 11 to choose from
        If lastVersionAdded = tbHelperSettings.twinBASICFolder.tBVersion Then
            lstZipFiles.AddItem("twinBASIC_IDE_BETA_" & lastVersionAdded & ".zip") ' add the last one
        End If
    
    End Sub
    
    Private Sub FillEntries()
    
        ' fill the revert change log with the selected revert to version change log
        rvtVersionChangeLog.BeginUpdate()
        Dim revertToCL As clsChangeLogItem
        For Each revertToCL In revertToCLs
            If revertToCL.tBVersion = revertToVersion Then
                rvtVersionChangeLog.AddEntry(revertToCL.Type, revertToCL.Notes)
            End If
        Next
        rvtVersionChangeLog.EndUpdate()
        
    End Sub
    
    Private Sub SetRevertChangeLogHeader()
        
        Dim clgColumns(1) As New clsChangeLogColumn
        clgColumns(0).Name = "TYPE"
        clgColumns(0).Width = 140
        clgColumns(0).WrappedEnabled = False

        clgColumns(1).Name = "DESCRIPTION"
        clgColumns(1).Width = 600
        clgColumns(1).WrappedEnabled = True

        rvtVersionChangeLog.SetColumns = clgColumns

    End Sub
    
    Public Function GetZipFileVersionNumber(fromText As String) As String
    
        ' find the version number from the string passed
        ' simply appending each number found - needed after re-release of 870
        Dim versionNumber As String
        Dim i As Integer
        Dim aChar As String
    
        For i = 1 To Len(fromText)
            aChar = Mid(fromText, i, 1)
            If IsNumeric(aChar) Then
                versionNumber = versionNumber & aChar
            End If
        
        Next i

        GetZipFileVersionNumber = versionNumber
    
    End Function
    
    Private Sub frmRevertView_Click()
        ZipPicker.Collapse()
        HideZipList
    End Sub
    
    Private Sub btnGetVersionsFromGitHub_Click()
        
        lblCurrentDownloadFolder.Caption = lblCurrentDownloadFolder.Caption & " and GitHub"
        revertGetGitHubVersionsClicked = True
        UpdateActivityLog "Getting versions to revert to from GitHub"
        FillGitHubZips
        UpdateActivityLog "done", True
        revertGetGitHubVersionsClicked = False
        
        FlushRedraws
        
    End Sub
    
    Private Sub btnReverttB_Click()
        
        If MessageBox("Are you [b]sure[/b] you want to revert the current version of twinBASIC ([font color=vbblue][b]" & tbHelperSettings.twinBASICFolder.tBVersion & "[/b][/font]) to version [font color=vbgreen][b]" & _ 
            revertToVersion & "[/b][/font]?", "question", "Reverting twinBASIC", "Yes", "No") = "No" Then Exit Sub
        
        Me.MousePointer = vbHourglass
        
        ' check that the IDE is closed before attempting to revert
        If IsProcessRunning("twinbasic.exe") Then UpdateActivityLog "Not allowed while the IDE is open"
        If Not WaitUntilTwinBasicIsClosed("revert") Then
            UpdateActivityLog "Revert cancelled"
            Me.MousePointer = vbDefault
            FlushRedraws()
            Exit Sub
        End If
        
        UpdateActivityLog "Selected to revert from version " & tbHelperSettings.twinBASICFolder.tBVersion & " to " & revertToVersion
        
        ' revert the version in the twinBASIC location
        Dim revertToZipFileName As String
        
        Dim revertDownloadFolder As String
        revertDownloadFolder = tbHelperSettings.DownloadFolder.Path
        If Len(revertDownloadFolder) > 0 And Right$(revertDownloadFolder, 1) <> "\" Then revertDownloadFolder = revertDownloadFolder & "\"
        revertToZipFileName = revertDownloadFolder & Replace(ZipPicker.Item, "[local]", "")
        
        If revertToVersionRequiresDownload Then
        
            ' the user selected a version of twinBASIC that is not available locally
            Dim revertToURL As String = githubReleasesURL & "/download/beta-x-" & IIf(revertToVersion < 1000, "0" & CStr(revertToVersion), revertToVersion)
            
            UpdateActivityLog "Revert requires downloading twinBASIC " & revertToVersion
            If Not DownloadUrlToFile(revertToURL & "/" & ZipPicker.Item, revertToZipFileName) Then
                UpdateActivityLog "Download failed. twinBASIC was not changed."
                Me.MousePointer = vbDefault
                MessageBox("The download did not finish, so the twinBASIC folder was not changed.", "error", "Download failed")
                Exit Sub
            End If
            UpdateActivityLog "done ", True
                
        End If
        
        UpdateActivityLog "Expanding twinBASIC " & revertToVersion
        If Not InstallTwinBasic(revertToZipFileName) Then
            UpdateActivityLog "Revert failed"
            Me.MousePointer = vbDefault
            MessageBox(PlainMessage(lastInstallError), "error", "Revert Result")
            Exit Sub
        End If
        UpdateActivityLog "done", True
        
        ' update the form to indicate that the version was reverted to an older version
        lblCurrentTBVersion.Caption = InstalledVersion & revertToVersion
        
        btnDownload.Caption = CheckForVersion
        btnDownload.Enabled = True
                
        Me.MousePointer = vbDefault
        MessageBox("The revert process has finished successfully.", "info", "Revert Result")  ' let the user know all is well
        
        MoveRevertCLToMain  ' add the revert version change log to the main form's object
        
        ' update the main form 
        FilltBChangeLog
        SetInitialTypeFilters
        
        Label9.Caption = "Change Log for "
        lblNewVersions.Caption = revertToVersion
        chgLogs.LatestVersion = revertToVersion
        
        FlushRedraws
        
        HidePanelView pnlRevert
        
    End Sub
    
    Private Sub MoveRevertCLToMain()
        
        ' add the reverted to version's change log to the main object
        Dim revertToCL As clsChangeLogItem

        Set chgLogs = New colChangeLogItems
        
        For Each revertToCL In revertToCLs
            chgLogs.Add(revertToCL.tBVersion, revertToCL.Type, revertToCL.Notes)
        Next
        
        Set revertToCL = Nothing
        Set revertToCLs = Nothing
        
    End Sub
    
    Private Sub lblCloseRevert_Click()
        
        HidePanelView pnlRevert
        
    End Sub
    
    Private Sub lblCloseLogHistoryView_Click()
        
        HidePanelView pnlViewLogHistory
        
    End Sub
    
    Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
        
        ' this doesn't work currently as once a fame is displayed and hid
        ' the form no longer run this event, will revisit in beta 2 (TODO) 
        If KeyCode = vbKeyEscape Then
            If isAPanelDisplayed Then
                pnlMessageBox.Visible = False
                pnlRevert.Visible = False
                pnlViewLogHistory.Visible = False
            End If
        End If
    End Sub
    
    Private Sub frmInnerRevertView_Click()
        
        HideZipList()
    End Sub
    
    '***********************************************
    '*****  Select Folder
    '******************************************
    Private Sub ConfigureSelectFolderButtons()
        
        'setup the user control download button
        With btnOkay
            .Caption = "Okay"
            .BackColor = CUST_BTN_BCOLOR  ' Blue
            .ForeColor = vbWhite  ' White
            .FontSize = 11
            '.HoverColor = RGB(18, 40, 234) ' Darker blue
            .BorderRadius = 3
            .FontBold = False
            .ButtonImagePtr = 0
            .IconSize = 0
            .IconSpacing = 0
            .Enabled = True
        End With
        
        With btnCancelSelectFolder
            .Caption = "Cancel"
            .BackColor = CUST_BTN_BCOLOR  ' darker grey
            .ForeColor = vbWhite
            .FontSize = 11
            '.HoverColor = RGB(37, 99, 235)
            .BorderRadius = 3
            .FontBold = False
            .ButtonImagePtr = 0
            .IconSize = 0
            .IconSpacing = 0
            .Enabled = True
        End With
        
    End Sub
    
    Private Function DoesDriveExist(driveLetter As String) As Boolean
        
        Dim searchResult As Boolean = False
        Dim indexNo As Integer = 0
        
        Do Until (searchResult Or indexNo = lstDrives.ListCount)
            lstDrives.ListIndex = indexNo
            searchResult = (UCase(driveLetter) = UCase(lstDrives.Text))
            indexNo = indexNo + 1
        Loop
        
        DoesDriveExist = searchResult
        
    End Function
    
    Private Sub PopulateDrivesList()
        
        'TODO: add volume label to the drive list
        Dim drives As Long
        Dim i As Long
        Dim driveLetter As String
        Dim driveType As Long
        Dim volumeLabel As String
        
        drives = GetLogicalDrives()
        lstDrives.Clear

        For i = 0 To 25
            If (drives And (2 ^ i)) <> 0 Then
                driveLetter = Chr$(65 + i) & ":"
                driveType = GetDriveType(driveLetter & "\")
                If driveType = DRIVE_FIXED Or driveType = DRIVE_REMOVABLE Then
                    'volumeLabel = Dir(driveLetter & ":\", vbVolume)
                    lstDrives.AddItem driveLetter
                End If
            End If
        Next i
    End Sub

    Private Sub DrivePicker_DropDown()
        
        ' toggle the dropdown if it is visible
        If lstDrives.Visible Then
            HideDriveList()
            Exit Sub
        End If
        
        ' Find the currently selected drive in the list and highlight it
        Dim i As Long
        For i = 0 To lstDrives.ListCount - 1
            If lstDrives.List(i) = DrivePicker.Item Then
                lstDrives.ListIndex = i
                Exit For
            End If
        Next i

        ConfigureDropdownListbox lstDrives, DrivePicker
                
    End Sub

    Private Sub lstDrives_Click()
        
        ' When a new drive is selected from the list...
        If lstDrives.ListIndex > -1 Then
            DrivePicker.Item = lstDrives.Text ' Update the picker display
            
            FolderList.ShowDrive lstDrives.Text
                        
            ' Hide the list
            HideDriveList
            FlushRedraws
        End If
    End Sub

    Private Sub HideDriveList()
        
        DrivePicker.Collapse()
        lstDrives.Visible = False
        picDropDownBorder.Visible = False
        
    End Sub
    
    Private Sub btnOkay_Click()
        
        ' assign the selection to the proper textbox

        If Len(FolderList.Path) > 0 Then
            ' there was a selection
            Dim txtBox As Control
            
            If InStr(lblSelectFolderTitle.Caption, "download") > 0 Then
                Set txtBox = txtDownloadFolder
                Dim newFolder As clsSettingsFolder
                newFolder.Path = FolderList.Path
                tbHelperSettings.DownloadFolder = newFolder

            Else
                If Val(GetTBVersionInFolder(FolderList.Path & "\")) = 0 Then
                    ' twinBASIC is not in the selected location
                    MessageBox("The folder chosen, [font color=vbBlue]'" & FolderList.Path & "' [/font][b]does not contain twinBASIC[/b].", "error", "Invalid twinBASIC folder selection")
                    Exit Sub
                End If
                
                Set txtBox = txttBFolderLocation
                tbHelperSettings.twinBASICFolder.Path = FolderList.Path & "\"
                btnDownload.Enabled = True ' user can now check for a new version once a valid folder is selected
                
            End If
            
            txtBox.Text = FolderList.Path
            If Right(txtBox.Text, 1) <> "\" Then txtBox.Text = txtBox.Text & "\"
            
        End If
        
        Set txtBox = Nothing
        
        HidePanelView pnlSelectFolder
    End Sub

    Private Sub btnCancelSelectFolder_Click()
        
        HidePanelView pnlSelectFolder
        MessageBox("A folder wasn't chosen, [b]the operation was cancelled[/b].", , "No selection")
        
    End Sub
    
    Private Sub lblCloseSelectFolder_Click()
        
        HidePanelView pnlSelectFolder
        MessageBox("A folder wasn't chosen, [b]the operation was cancelled[/b].", , "No selection")
        
    End Sub
    
    Private Sub frmInnerSelectFolder_Click()
        
        HideDriveList
    End Sub
    
    Private Sub tmrCatchUp_Timer()
        ' check for remaining UI updates that may have happened to quickly
        tmrCatchUp.Enabled = False
        'WriteToDebugLogFile("tmrCatchUp: RedrawCount=" & RedrawQueue.Count)
        If RedrawQueue.Count > 0 Then FlushRedraws()

        If frmInnerSelectFolder.Visible Then
            Debug.Print "refresh attempt from tmrCatchup"
            FolderList.Update()
            FolderList.SetFocus()
            frmInnerSelectFolder.Refresh()
        End If
    End Sub
    
    Private Sub CalculateDPIValues()
        
        ' Font.Size is in points, which Windows already scales for the monitor.
        ' Multiplying the point size by the DPI factor makes the text too large.
        drop_DPIFontSize = TEXT_BASE_FONT_SIZE

    End Sub

End Class