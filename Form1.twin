    Private Sub txtDownloadFolder_LostFocus()
        
        ' check for the message box displaying or the form is closing
        If isAPanelDisplayed Or formIsClosing Then Exit Sub
        
        If fso.FolderExists(txtDownloadFolder.Text) Then
            ' complete the path
            If Right(txtDownloadFolder.Text, 1) <> "\" Then txtDownloadFolder.Text += "\"

            tbHelperSettings.DownloadFolder.Path = txtDownloadFolder.Text
            txtDownloadFolder.SetValidView(True)
            
        Else
            ' indicate an invalid selection
            txtDownloadFolder.SetValidView(False, "Folder does not exisit")
        End If
        
        EnableDownloadButton()
        
        FlushRedraws
    End Sub
    
    Private Sub txttBFolderLocation_LostFocus()
        
        ' check for the message box displaying
        If isAPanelDisplayed Or formIsClosing Then Exit Sub
        
        Dim newtBLocationFolder As Boolean = False
        Dim previousPath As String = tbHelperSettings.twinBASICFolder.Path
                
        ' if there is a folder name in the textbox and folder doesn't exist, create it?
        If Not fso.FolderExists(txttBFolderLocation.Text) And Not Trim(txttBFolderLocation.Text) = "" Then
            ' ask the user if the folder should be created (like a first time setup)
            If MessageBox("This folder doesn't exist. Should it be created?", "question", "twinBASIC Location", "Yes", "No") = "Yes" Then
                On Error Resume Next
                fso.CreateFolder(txttBFolderLocation.Text)
                If Not fso.FolderExists(txttBFolderLocation.Text) Then
                    UpdateActivityLog "Unable to create the twinBASIC folder " & txttBFolderLocation.Text & " as requested"
                    MessageBox("Unable to create the folder." & vbCrLf & Err.Description, "error", "Creation Error")
                    txttBFolderLocation.SetValidView(False, "Folder cold not be created")
                    txttBFolderLocation.SetFocus()
                Else
                    tbHelperSettings.twinBASICFolder.Path = txttBFolderLocation.Text
                    tbHelperSettings.twinBASICFolder.ForceValid
                    
                    txttBFolderLocation.SetValidView(True)
                    lblCurrentTBVersion.Caption = InstalledVersion & " N/A"
                    newtBLocationFolder = True
                    UpdateActivityLog "The twinBASIC folder " & txttBFolderLocation.Text & " was created"
                End If
                On Error GoTo 0
            End If
        End If
        
        Me.MousePointer = vbHourglass
        
        ' is the folder to install twinBASIC to valid?
        If Not newtBLocationFolder Then
            ' the user didn't create a new tBFolder
            'WriteToDebugLogFile("Lost focus - checking folder for its tB version")
            If fso.FolderExists(txttBFolderLocation.Text) Then
            
                ' complete the path
                If Right(txttBFolderLocation.Text, 1) <> "\" Then txttBFolderLocation.Text += "\"
                
                Dim prevInstalledVersion As Integer = tbHelperSettings.twinBASICFolder.tBVersion
                
                tbHelperSettings.twinBASICFolder = txttBFolderLocation.Text
                
                'WriteToDebugLogFile("Lost focus - GetTBVersionInFolder returned " & tbHelperSettings.twinBASICFolder.tBVersion)
                If tbHelperSettings.twinBASICFolder.tBVersion = 0 Then
                    ' indicate an invalid selection
                    lblCurrentTBVersion.Caption = ""
                    txttBFolderLocation.SetValidView(False, "Folder does not contain twinBASIC")
                
                    MessageBox("Folder [font color=vbBlue]'" & txttBFolderLocation.Text & "' [/font]; no twinBASIC version found.", "info", "twinBASIC version check")
                Else
                    
                    If Not txttBFolderLocation.IsViewValid Then txttBFolderLocation.SetValidView(True)
                    
                    ' this didn't update the label properly (maybe need a custom control for it)
                    lblCurrentTBVersion.Caption = InstalledVersion & tbHelperSettings.twinBASICFolder.tBVersion
                    'InvalidateRect(Form1.hWnd, 0, 1)
                    'UpdateWindow(Form1.hWnd)
                    
                    'WriteToDebugLogFile("label updated and queued (" & Form1.hWnd & ") form for redraw (" & lblCurrentTBVersion.Caption & ")")
                                        
                    If prevInstalledVersion <> tbHelperSettings.twinBASICFolder.tBVersion Then
                        ' a new location with twinBASIC was selected, if the setting for check for a new version on load then check
                        
                        If FoldersAreValid Then
                            
                            If tbHelperSettings.CheckForNewVersionOnLoad Then
                                CheckForNewVersion
                            Else
                                SetDownloadButtonToCheckForVersion
                            End If
                        End If
                        
                    End If
                    
                    'tbHelperSettings.twinBASICFolder.Path = txttBFolderLocation.Text
                End If
                
                
            Else
                ' indicate an invalid selection
                lblCurrentTBVersion.Caption = ""
                txttBFolderLocation.SetValidView(False, "Folder does not exisit")
            End If
                        
        End If
        
        InvalidateLabelRegion lblCurrentTBVersion
        
        FlushRedraws()
        
        Me.MousePointer = vbDefault
 
        EnableDownloadButton
        FlushRedraws()
        
    End Sub
    
    '**************************************
    '   local procedures
    '**************************************** 
    Private Sub CheckForNewVersion()
        
        ' should tBHelper look for a newer version?
        UpdateActivityLog "Checking for new version"
        chgLogs.GetNewerReleasedVersions(tbHelperSettings.twinBASICFolder.tBVersion, True)
            
        If chgLogs.tBVersionGap > 0 Then
            ' there is at least 1 new version available
            btnDownload.Caption = "Download version " & chgLogs.LatestVersion
            'btnDownload.PngIconPath = downloadIcon
            btnDownload.ButtonImagePtr = GetImagePtr(resDownload)
            
            FilltBChangeLog()
            UpdateActivityLog "Newest version available is " & chgLogs.LatestVersion
        Else
            UpdateActivityLog "No newer version available"
        End If
           
        EnableDownloadButton
        
    End Sub
    
    Private Sub ConfigureToggleSlider(tsToggle As ucToggleSlider)
        
        tsToggle.OnColor = CUST_BTN_BCOLOR
        tsToggle.SlideSpeed = 3
        
    End Sub
    
    Private Sub ConfigureTypeFilterButton(tfButton As ucTypeFilter, buttonCaption As String, buttonBackColor As Long, Optional FilterText As String = "")
        
        If FilterText = "" Then FilterText = buttonCaption
        
        tfButton.BorderRadius = 3
        tfButton.TypeName = buttonCaption
        tfButton.FilterText = FilterText
        tfButton.WidthOverride = 1065
        tfButton.Backcolor = buttonBackColor
        tfButton.FontSize = 9.75
        tfButton.Enabled = False
        
    End Sub
    
    Private Sub EnableDownloadButton()

        ' should the download zip button be enabled?
        'WriteToDebugLogFile "EnableDownloadButton FoldersAreValid " & FoldersAreValid & "; chgLogs.tBVersionGap: " & chgLogs.tBVersionGap & " btnDownload.Caption='" & btnDownload.Caption & "'"
        
        ' the download and the twinBASIC folder are valid 
        ' and (there is a difference between the available version and the installed version or the button is set to manually check for a new version)
        btnDownload.Enabled = FoldersAreValid And (chgLogs.tBVersionGap > 0 Or btnDownload.Caption = CheckForVersion)
        
        If btnDownload.Enabled Then
            ' add the final forward slash if needed
            If Right(txtDownloadFolder.Text, 1) <> "\" Then txtDownloadFolder.Text += "\"
            If Right(txttBFolderLocation.Text, 1) <> "\" Then txttBFolderLocation.Text += "\"
        End If
        
    End Sub
    
    Public Sub FilltBChangeLog()
        
        ' inital write of entries to the changelog 
        Dim clItem As clsChangeLogItem
        
        lblNewVersions.Caption = ""
         'WriteToDebugLogFile("FilltBChangeLog versoin gap:" & chgLogs.tBVersionGap)
        If chgLogs.tBVersionGap > 1 Then
           
            Label9.Caption = "Change logs for "
            lblNewVersions.Caption = CStr(tbHelperSettings.twinBASICFolder.tBVersion + 1) & IIf(chgLogs.tBVersionGap = 2, " and ", " thru ") & chgLogs.LatestVersion
            
        ElseIf chgLogs.tBVersionGap = 1 Then
            Label9.Caption = "Change Log for "
            lblNewVersions.Caption = chgLogs.LatestVersion
        Else
            Label9.Caption = "Change Log"
        End If
        
        clgView.Clear
        
        clgView.BeginUpdate()
        For Each clItem In chgLogs
            clgView.AddEntry(clItem.tBVersion, clItem.Type, clItem.Notes)
        Next
        clgView.EndUpdate()
        
    End Sub
    Private Function FoldersAreValid() As Boolean
    
         Return tbHelperSettings.DownloadFolder.IsValid And tbHelperSettings.twinBASICFolder.IsValid
        
    End Function
    
    Private Sub LoadSettingsIntoForm()
    
        'Set the controls on the form with their settings values
        With Form1
            .txtDownloadFolder.Text = tbHelperSettings.DownloadFolder.Path
            .txttBFolderLocation.Text = tbHelperSettings.twinBASICFolder.Path
            Select Case tbHelperSettings.PostDownloadAction
                Case 1
                    .optOpenFolder.Value = True
                Case 2
                    .optOpenZip.Value = True
                Case 3
                    .optInstallTB.Value = True
            End Select
            .tsLookForUpdateAtLaunch.IsOn = tbHelperSettings.CheckForNewVersionOnLoad
            .tsStartTB.IsOn = tbHelperSettings.StarttwinBASICAfterUpdate
            .tsLogActivity.IsOn = tbHelperSettings.LogActivity
            .tsSaveSettingsOnExit.IsOn = tbHelperSettings.SaveSettingsOnExit
        End With
    
    End Sub

    Private Function PlainMessage(ByVal messageText As String) As String
        ' MessageBox treats square brackets as style tags.
        PlainMessage = Replace(Replace(messageText, "[", "("), "]", ")")
    End Function

    Private Function WaitUntilTwinBasicIsClosed(ByVal actionName As String) As Boolean
        
        ' The compiled helper can replace files only while twinBASIC.exe is not locking them.
        ' When this project is running inside the IDE, closing the IDE is not an option.
        If IsCodeRunningInTheIDE Then
            WaitUntilTwinBasicIsClosed = True
            Exit Function
        End If
        
        Do While IsProcessRunning("twinbasic.exe")
            Dim response As String
            response = MessageBox("[font color=vbred]The twinBASIC IDE is running[/font]. Close it before the " & actionName & " can replace the program files." & vbCrLf & _
                "[font color=blue]Close the IDE, then click Retry. Click Cancel to leave the current version in place.[/font]", _
                "warning", "twinBASIC is running", "Retry", "Cancel")
            If StrComp(response, "Cancel", vbTextCompare) = 0 Or response = vbNullChar Or Len(response) = 0 Then
                WaitUntilTwinBasicIsClosed = False
                Exit Function
            End If
        Loop
        
        WaitUntilTwinBasicIsClosed = True
        
    End Function

    Private Function InstallTwinBasic(tBZipFile As String) As Boolean
        
        ' Extract the zip beside the live folder and swap only after twinBASIC.exe
        ' is present in the new copy. The previous folder is renamed aside, not
        ' deleted, and is put back if the swap fails.
        Dim installPath As String
        Dim parentPath As String
        Dim folderName As String
        Dim stagingPath As String
        Dim backupPath As String
        Dim stagedRoot As String
        Dim originalMoved As Boolean
        Dim zip As cZipArchive
        
        On Error GoTo InstallFailed
        
        InstallTwinBasic = False
        lastInstallError = ""
        originalMoved = False
        
        installPath = StripTrailingSlash(tbHelperSettings.twinBASICFolder.Path)
        If Len(installPath) < 4 Then
            lastInstallError = "The twinBASIC folder is not set."
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        
        If Not fso.FileExists(tBZipFile) Then
            lastInstallError = "Zip file was not found: " & tBZipFile
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        If fso.GetFile(tBZipFile).Size < 100000 Then
            lastInstallError = "Zip file is incomplete, so the twinBASIC folder was not changed: " & tBZipFile
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        
        parentPath = fso.GetParentFolderName(installPath)
        If Len(parentPath) = 0 Or Not fso.FolderExists(parentPath) Then
            lastInstallError = "The folder that should contain twinBASIC does not exist: " & parentPath
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        
        If Not CanWriteToFolder(parentPath) Then
            lastInstallError = "tbHelper cannot write to " & parentPath & ". The current twinBASIC folder was not changed. If that folder is under Program Files, run tbHelper as administrator and try again."
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        
        folderName = fso.GetFileName(installPath)
        backupPath = parentPath & "\" & folderName & ".__tbHelper_backup"
        stagingPath = parentPath & "\" & folderName & ".__tbHelper_new"
        
        ' A previous attempt may have moved the live folder aside and then failed
        ' before putting a new copy in its place. Put that copy back first.
        If Not fso.FolderExists(installPath) And fso.FolderExists(backupPath) Then
            UpdateActivityLog "Restoring the previous twinBASIC folder from " & backupPath
            fso.MoveFolder backupPath, installPath
        End If
        
        DeleteFolderIfExists stagingPath
        
        Set zip = New cZipArchive
        If Not zip.OpenArchive(tBZipFile) Then
            lastInstallError = "Could not open the zip file. The twinBASIC folder was not changed. " & zip.LastError
            UpdateActivityLog lastInstallError
            Exit Function
        End If
        
        UpdateActivityLog "Extracting " & tBZipFile & " to " & stagingPath
        If Not zip.Extract(stagingPath & "\") Then
            lastInstallError = "Could not extract the zip. The twinBASIC folder was not changed. " & zip.LastError
            UpdateActivityLog lastInstallError
            DeleteFolderIfExists stagingPath
            Exit Function
        End If
        
        stagedRoot = FolderContainingTwinBasicExe(stagingPath)
        If Len(stagedRoot) = 0 Then
            lastInstallError = "The zip did not contain twinBASIC.exe. The current folder was not changed."
            UpdateActivityLog lastInstallError
            DeleteFolderIfExists stagingPath
            Exit Function
        End If
        
        If fso.FolderExists(installPath) Then
            DeleteFolderIfExists backupPath
            UpdateActivityLog "Moving the current install aside to " & backupPath
            fso.MoveFolder installPath, backupPath
            originalMoved = True
        End If
        
        UpdateActivityLog "Placing the new version in " & installPath
        If StrComp(stagedRoot, stagingPath, vbTextCompare) = 0 Then
            fso.MoveFolder stagingPath, installPath
        Else
            fso.MoveFolder stagedRoot, installPath
            DeleteFolderIfExists stagingPath
        End If
        
        If Not fso.FileExists(installPath & "\twinBASIC.exe") Then
            Err.Raise vbObjectError, "InstallTwinBasic", "twinBASIC.exe was not found after the folder was replaced"
        End If
        
        If originalMoved Then
            On Error Resume Next
            fso.DeleteFolder backupPath, True
            If Err.Number <> 0 Then
                UpdateActivityLog "The new version is in place. The previous copy is still at " & backupPath
            End If
            Err.Clear
            On Error GoTo InstallFailed
        End If
        
        lastInstallError = ""
        InstallTwinBasic = True
        Exit Function
        
InstallFailed:
        If Len(lastInstallError) = 0 Then lastInstallError = "Install failed: " & Err.Description
        UpdateActivityLog lastInstallError
        
        On Error Resume Next
        If originalMoved And fso.FolderExists(backupPath) Then
            If fso.FolderExists(installPath) Then
                If Not fso.FileExists(installPath & "\twinBASIC.exe") Then fso.DeleteFolder installPath, True
            End If
            If Not fso.FolderExists(installPath) Then
                Err.Clear
                fso.MoveFolder backupPath, installPath
                If Err.Number = 0 Then
                    UpdateActivityLog "Restored the previous twinBASIC folder"
                    lastInstallError = lastInstallError & " The previous twinBASIC folder was restored."
                Else
                    UpdateActivityLog "Could not restore the previous folder from " & backupPath & ": " & Err.Description
                    lastInstallError = lastInstallError & " The previous copy is still at " & backupPath & "."
                End If
            Else
                lastInstallError = lastInstallError & " The previous copy is still at " & backupPath & "."
            End If
        End If
        DeleteFolderIfExists stagingPath
        InstallTwinBasic = False
        
    End Function
    
    '******************************************************
    '**** Message Box
    '******************************************************
    Private Function MessageBox(ByVal msgText As String, _
        Optional ByVal msgType As String = "info", _
        Optional ByVal msgTitle As String = vbNullString, _
        Optional ByVal btn1Caption As String = "OK", _
        Optional ByVal btn2Caption As String = vbNullString, _
        Optional ByVal btn3Caption As String = vbNullString) As String
            
        buttonCaption = ""
        
        'Load icon based On type
        Select Case LCase$(msgType)
            Case "info": picIcon.Picture = GetImageStd(resInfo)
            Case "warning": picIcon.Picture = GetImageStd(resWarning)
            Case "error": picIcon.Picture = GetImageStd(resError)
            Case "success": picIcon.Picture = GetImageStd(resSuccess)
            Case "question": picIcon.Picture = GetImageStd(resQuestion)
        End Select
        picIcon.PictureDpiScaling = True
        ' Select Case LCase$(msgType)
        '     Case "info": picIcon.Picture = LoadPicture(App.Path & "\info.png")
        '     Case "warning": picIcon.Picture = LoadPicture(App.Path & "\warning.png")
        '     Case "error": picIcon.Picture = LoadPicture(App.Path & "\error.png")
        '     Case "success": picIcon.Picture = LoadPicture(App.Path & "\success.png")
        '     Case "question": picIcon.Picture = LoadPicture(App.Path & "\question.png")
        ' End Select
        
        'WriteToDebugLogFile("MessageBox called msgTitle: " & msgTitle)
        
        ' setup the buttons to answer the message box   
        ' ConfigureCustomButton btnNum1, btn1Caption, CUST_BTN_BCOLOR, vbWhite, "", 20, True, True
        ' ConfigureCustomButton btnNum2, btn2Caption, CUST_BTN_BCOLOR, vbWhite, "", 20, btn2Caption <> vbNullString, True
        ' ConfigureCustomButton btnNum3, btn3Caption, CUST_BTN_BCOLOR, vbWhite, "", 20, btn3Caption <> vbNullString, True
        
        ConfigureCustomButton btnNum1, btn1Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, True, True
        ConfigureCustomButton btnNum2, btn2Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, btn2Caption <> vbNullString, True
        ConfigureCustomButton btnNum3, btn3Caption, CUST_BTN_BCOLOR, vbWhite, resNone, 20, btn3Caption <> vbNullString, True
                        
        btnNum2.Visible = btn2Caption <> vbNullString
        btnNum3.Visible = btn3Caption <> vbNullString
        lblMessageTitle.Caption = msgTitle
        RTFMsg.Message = msgText
        
        ShowPanelView frmInnerMsgBox

        pnlMessageBox.MousePointer = vbDefault
        
        ' wait until the user clicks a button
        Do While pnlMessageBox.Visible
            DoEvents()
        Loop
        
        MessageBox = buttonCaption
        buttonCaption = vbNullChar
        
    End Function
    
    Private Sub btnNum1_Click()
        buttonClick btnNum1.Caption
        
    End Sub
    
    Private Sub btnNum2_Click()
        
        ' this will might be used for cancel, check the caption to send the proper button response
        buttonClick btnNum2.Caption

    End Sub
    
